# ============================================================
# Stack 3 - Provider Routing & Execution - Environment Config
# ============================================================

# --- API ---
PORT=8080
NODE_ENV=production
SERVICE_NAME=ai-gateway-3-of-10-provider-routing

# --- Upstream Stack 2 (Provider Registry) reference ---
STACK2_BASE_URL=http://host.docker.internal:4402

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ai_gateway_routing
POSTGRES_USER=ai_gateway
POSTGRES_PASSWORD=change_me_in_env

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Groq Provider ---
GROQ_API_KEY=
GROQ_DEFAULT_MODEL=openai/gpt-oss-20b
GROQ_ENABLED=true
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Gemini Provider ---
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-3.6-flash
GEMINI_ENABLED=true
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_in_env
