# ============================================================
# Stack 3 - Provider Routing & Execution - Environment Config
# ============================================================

# --- API ---
PORT=8080
NODE_ENV=production
SERVICE_NAME=ai-gateway-3-of-10-provider-routing

# --- Upstream Stack 2 (Provider Registry) reference ---
STACK2_BASE_URL=http://host.docker.internal:4402

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ai_gateway_routing
POSTGRES_USER=ai_gateway
POSTGRES_PASSWORD=change_me_in_env

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Groq Provider ---
GROQ_API_KEY=
GROQ_DEFAULT_MODEL=openai/gpt-oss-20b
GROQ_ENABLED=true
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Gemini Provider ---
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-3.6-flash
GEMINI_ENABLED=true
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_in_env

# ============================================================================
# PATCH_MARKER_ENV_EXAMPLE_V1
# ============================================================================

# --- Capability routing overrides (optional) ---
# One override per capability tag that appears in your model catalogs
# (chat, reasoning, vision, code, tool-use, multimodal, long_context, ...).
# Only honored if the named provider actually has a model advertising that
# capability; otherwise it's ignored and logged at startup.
# ROUTING_CHAT_PROVIDER=groq
# ROUTING_VISION_PROVIDER=groq
# ROUTING_MULTIMODAL_PROVIDER=gemini

# --- Internal daily token-usage throttle ---
# 0 = disabled (default). When > 0, the gateway stops dispatching new
# requests (returns 429 DAILY_TOKEN_BUDGET_EXCEEDED) once this many total
# tokens have been used since 00:00 UTC. Resets automatically each day.
DAILY_TOKEN_BUDGET=0

# --- Optional JSON-driven provider/model/credential overrides ---
# IMPORTANT: each of these is ONE array covering every provider at once —
# config.js filters entries internally by their own "provider"/"id" field.
# Do NOT create per-provider variants of these names (e.g. GEMINI_MODELS_JSON)
# — only these three exact variable names are read. If a key is repeated in
# this file, only the LAST occurrence takes effect; merge providers into a
# single array instead of duplicating the variable.
# AI_PROVIDERS_JSON=[{"id":"groq","enabled":true,"priority":10,"weight":100},{"id":"gemini","enabled":true,"priority":9,"weight":90}]
# AI_MODELS_JSON=[{"provider":"groq","model":"openai/gpt-oss-20b","enabled":true,"priority":8,"lifecycle":"stable","capabilities":["chat","reasoning"],"context_window":131072,"max_completion_tokens":65536}]
# AI_CREDENTIALS_JSON=[{"provider":"groq","credentials":[{"id":"groq-primary","enabled":true,"priority":10,"secret_env":"GROQ_API_KEY_1"}]}]
